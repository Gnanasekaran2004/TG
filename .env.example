# Trip-GUY Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# NEVER commit the actual `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Gemini AI API Key (for TripBOT assistant)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# EmailJS Configuration (for OTP email delivery)
# Obtain from: https://www.emailjs.com/
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_otp_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_GOODBYE_TEMPLATE_ID=your_goodbye_template_id
